{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    /* `vite/client` is what types the asset imports — `import logo from
       "./x.png"` is a string URL Vite resolves at build time, and without this
       TypeScript only sees a module that does not exist. */
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",

    /* Type-safety settings. These are strict on purpose: they are what makes
       TypeScript catch mistakes before you ever open the browser. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "skipLibCheck": true,

    /* Vite does the compiling. TypeScript only checks types, never emits files. */
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"]
}
