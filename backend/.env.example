NODE_ENV=development
HOST=0.0.0.0
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Left unset here on purpose: with no reverse proxy in front (local dev, or
# this port reached directly) every request's IP must come from the real TCP
# connection, not a header anyone connecting can set themselves.
#
# Behind one Nginx or Caddy on the same host, uncomment ONE of:
#   TRUST_PROXY=1            # trust exactly one hop back from the connection
#   TRUST_PROXY=127.0.0.1    # trust that hop only when it's actually the proxy
# The second is what Fastify's own deployment guide recommends — it still
# protects request.ip if this port is ever reachable directly, which the
# first does not. Never set this to `true`: that trusts the WHOLE forwarded
# chain, including a prefix an attacker attached to their own request, and
# quietly turns the login rate limit into something anyone can bypass.
# TRUST_PROXY=127.0.0.1

# One SQLite file = one database. Nothing else on the server can read Lindero's
# data unless it is pointed at this exact path.
DATABASE_PATH=./data/lindero.db

# Where uploaded proof-of-payment images and PDFs are stored. Back this up
# alongside the database: the rows point at these files, so one without the
# other is a receipt whose evidence has gone missing.
UPLOADS_PATH=./data/uploads

# Signs the session cookie. Generate with:  openssl rand -base64 48
# The server refuses to start in production if this is left at the default.
COOKIE_SECRET=lindero-development-cookie-secret-change-me

# How many days a login stays valid.
SESSION_DAYS=7

# How many login attempts one IP address may make per minute.
LOGIN_ATTEMPTS_PER_MINUTE=10

# How often to refresh the lempira/dollar rate from the market feed, in hours.
# Set to 0 to disable the automatic fetch entirely: the rate then only changes
# when a supervisor types one, and the server makes no outbound requests.
# The rate is display-only — payments always store the rate they were settled at.
EXCHANGE_RATE_REFRESH_HOURS=6

# The timezone the BUSINESS keeps its calendar in, as an IANA name.
#
# Not the server's timezone. Lindero records calendar DATES — the day a payment
# came in, the day an installment falls due — and every one of them has to be
# decided in the office's calendar. Deriving them from UTC put Honduras a day
# ahead of itself from six in the evening onwards.
#
# This is the only place the zone is set. The server publishes it with the
# session, so the browser picks it up on sign-in — there is nothing to change
# in the frontend.
TIME_ZONE=America/Tegucigalpa
