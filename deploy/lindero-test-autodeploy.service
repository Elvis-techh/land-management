# Runs deploy/autodeploy.sh once for the test site; started by
# lindero-test-autodeploy.timer. From the live checkout on purpose: see
# site-settings.sh.

[Unit]
Description=Lindero test site: deploy a new build from deploy-build-test, if there is one
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/lindero/deploy/autodeploy.sh test

# The same low priority as a live deploy (see lindero-autodeploy.service).
Nice=10
CPUWeight=20
IOWeight=20
MemoryHigh=200M
TimeoutStartSec=15min
