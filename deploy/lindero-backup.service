# Runs one backup, then exits. Paired with lindero-backup.timer.
#
#   cp deploy/lindero-backup.{service,timer} /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now lindero-backup.timer
#
# Run one now:  systemctl start lindero-backup
# See history:  journalctl -u lindero-backup

[Unit]
Description=Lindero database + uploads backup

[Service]
Type=oneshot
User=lindero
Group=lindero
WorkingDirectory=/opt/lindero/backend
EnvironmentFile=-/opt/lindero/backend/.env

# /usr/bin/node is correct where Lindero has the machine to itself and the
# system Node is 22+. It is WRONG on a droplet shared with an application
# pinned to an older Node, where deployment-shared-droplet.md installs 22
# separately and leaves /usr/bin/node alone — there, override this with a
# drop-in exactly as lindero-api.service does.
#
# Getting it wrong here is quieter than getting it wrong on the API. The API
# fails to start and you see it immediately; this unit only runs at 02:15, so
# a better-sqlite3 built for a different Node ABI surfaces as a backup that
# has silently not happened for weeks. Run `systemctl start lindero-backup`
# once by hand after install and read the log — that is the whole check.
ExecStart=/usr/bin/node scripts/backup.mjs

# Uncomment once an off-machine destination is set up — a backup that only ever
# lands on the same disk as the database is not a backup. Example with rclone:
# ExecStartPost=/usr/bin/rclone copy /opt/lindero/backend/backups remote:lindero-backups

# Must exist before the unit starts, for the same reason as in
# lindero-api.service: the namespace is built before the script runs, so
# `mkdirSync` inside backup.mjs is too late to help.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/lindero/backend/backups
