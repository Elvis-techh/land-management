# Reference Nginx config for Lindero: one server serving the built frontend
# as static files, reverse-proxying everything under /api/ to the Fastify
# backend. Matches how the Vite dev server already proxies /api/ in
# development (see frontend/vite.config.ts) — the frontend only ever calls
# relative "/api/..." paths, in dev or in production, and never needs to know
# the backend's address.
#
# This is a starting point, not a drop-in file: replace every <PLACEHOLDER>,
# then read it once end to end before using it.
#
# Pairs with backend/.env.example's TRUST_PROXY setting. Whatever you set
# `proxy_set_header X-Forwarded-For` to here is only as trustworthy as what
# TRUST_PROXY is told to believe on the backend — see the comment there. This
# file assumes Nginx and the Node process run on the same host and talk over
# loopback, which is what TRUST_PROXY=127.0.0.1 expects.
#
# Also set backend/.env's FRONTEND_ORIGIN to https://<YOUR_DOMAIN> — same
# domain here means most requests are same-origin and skip CORS entirely, but
# the backend still checks Origin on any request that does send one.

# Redirect all plain HTTP to HTTPS. Left listening on 80 (rather than closed)
# so an ACME HTTP-01 challenge (certbot) can still complete here.
server {
    listen 80;
    listen [::]:80;
    server_name <YOUR_DOMAIN>;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    # Separate `http2 on;` directive needs Nginx 1.25.1+ (`nginx -v` to check).
    # Older Nginx — this is what Ubuntu 22.04's packaged version is — instead
    # takes it as a flag on `listen`: replace the two lines above with
    # `listen 443 ssl http2;` and `listen [::]:443 ssl http2;`.
    http2 on;
    server_name <YOUR_DOMAIN>;

    ssl_certificate     /etc/letsencrypt/live/<YOUR_DOMAIN>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<YOUR_DOMAIN>/privkey.pem;

    # A generic modern baseline — regenerate for your actual Nginx/OpenSSL
    # version at https://ssl-config.mozilla.org/ rather than trusting this
    # blindly for years.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:LinderoSSL:10m;
    ssl_session_tickets off;

    # Tells browsers to only ever use HTTPS with this host from now on.
    # Leave this OUT until you've confirmed HTTPS actually works — it is
    # sticky in the browser and not something a bad deploy lets you undo
    # quickly.
    # add_header Strict-Transport-Security "max-age=63072000" always;

    # The built frontend. `npm run build --workspace @lindero/frontend`
    # (or the root `npm run build`, which builds both workspaces) produces
    # this directory — copy it here as part of your deploy, it is not
    # generated on the server.
    root /var/www/lindero/frontend/dist;
    index index.html;

    # Client-side routing: any path Nginx can't find as a real file falls
    # back to index.html so the React router handles it, instead of Nginx
    # answering a deep link like /contracts/123 with its own 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ---------------------------------------------------------------------
    # Caching. Two extremes, and the reason is the filenames.
    # ---------------------------------------------------------------------

    # index.html must NEVER be held, and this is the rule that matters most.
    #
    # Every asset Vite produces carries a content hash in its name
    # (index-D_6pL1Go.js), so a new build writes new filenames and yesterday's
    # cached copy is simply never asked for again. index.html is the one
    # exception: its name never changes, and it is the file that NAMES those
    # hashes. A browser holding yesterday's copy asks for a bundle that
    # `rsync --delete` removed during the last deploy, and the app opens blank
    # — on somebody's phone, until a cache nobody can reach expires.
    #
    # Without an explicit header nginx sends none, and a browser with no
    # instructions applies HEURISTIC freshness: a file that has not changed in
    # a month may be held for days. Saying nothing is not the same as saying
    # "do not cache".
    #
    # "no-cache" does not mean "do not store" — it means revalidate before
    # using. The browser still gets a cheap 304 whenever nothing has changed,
    # so this costs one conditional request per launch, not a re-download.
    #
    # This also covers deep links: `try_files ... /index.html` performs an
    # INTERNAL REDIRECT, which re-enters location matching and lands here.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # The hashed assets, at the opposite extreme. The name changes whenever the
    # content does, so a copy already on the device is correct forever and
    # re-checking it is pure waste. `immutable` stops even the revalidation a
    # reload would otherwise force.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # The service worker: not hashed, and it decides what the app does on every
    # launch. `updateViaCache: "none"` in src/lib/serviceWorker.ts already
    # forces a network check from the registration side; this is the server
    # saying the same thing, for the browsers that ask before that code runs.
    location = /sw.js {
        add_header Cache-Control "no-cache";
    }

    # nginx's packaged mime.types has no entry for .webmanifest, so without
    # this the manifest is served as application/octet-stream and the browser
    # may refuse to treat the app as installable — which would take the
    # WhatsApp share target with it, since the OS share sheet only lists
    # installed apps.
    #
    # Deliberately `default_type` in an exact-match location rather than a
    # `types { }` block. A `types` block at server level REPLACES the inherited
    # map instead of extending it, so adding one entry would silently strip the
    # types for CSS, JavaScript and images — a much larger breakage than the
    # one being fixed. `default_type` only applies where the extension is
    # unknown, which is exactly this case.
    #
    # Not cached either: this is what Chrome re-reads to notice a new icon or a
    # new share target, and a held copy is how a manifest change goes unseen
    # for days.
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    # Everything the API needs — including downloading a receipt's proof of
    # payment — goes through this one block. There is deliberately no
    # separate `location` serving UPLOADS_PATH as static files: attachments
    # are permission-gated (see routes/receipts.ts), and serving them
    # directly from disk here would skip that check entirely.
    location /api/ {
        # No path after the port here — on purpose. That makes Nginx forward
        # the ORIGINAL request path, "/api/lots" and all, to the backend,
        # which is registered under that same "/api" prefix (see app.ts).
        # Adding a trailing "/" here would strip "/api/" before forwarding
        # and every route would 404.
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        # $proxy_add_x_forwarded_for APPENDS $remote_addr — the address Nginx
        # itself observed — to whatever X-Forwarded-For a client already
        # sent, rather than trusting the client's value outright. Fastify
        # then only takes the entry TRUST_PROXY says to trust (the one this
        # hop actually added), so a value someone hands Nginx themselves
        # can't reach request.ip. Using $remote_addr here instead would
        # DISCARD any earlier hops, which is wrong the moment there's a CDN
        # or load balancer in front of Nginx too.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Large receipt photos/PDFs: the backend's own ceiling is exactly 12MB
        # (MAX_ATTACHMENT_BYTES in lib/attachments.ts). Set a little above
        # that, not equal to it — multipart boundaries and the other form
        # fields in the same request add a few KB on top of the file itself,
        # and a request right at the backend's limit would otherwise be cut
        # off here first, with Nginx's own generic error instead of the
        # backend's "El archivo supera el máximo de 12 MB."
        client_max_body_size 13m;
    }
}
